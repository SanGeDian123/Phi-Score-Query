half4 main(float2 coord) {
    coord /= _SceneRenderScale;
    float2 uv = float2(coord.x / _ScreenParams.x, 1.0 - coord.y / _ScreenParams.y);
    // Keep the original full-resolution background and notes outside all effects.
    // Touch/disabled/ready use additive colour and may have zero active alpha.
    if (_OverlayOnly != 0 && sample_ComposeRT(uv).r + sample_EffectRT(uv).r +
        sample_EffectRT(uv).g + sample_DisabledComposeRT(uv).r +
        sample_ReadyComposeRT(uv).r + sample_TouchHoverRT(uv).r < 0.0001) {
        return half4(0.0);
    }
    float4 destination = sample_SceneColor(uv);
    float4 active = activeFragment(uv);
    // Real pass: Blend One OneMinusSrcAlpha. Touch RGB may be nonzero with zero area alpha.
    float factor = 1.0 - clamp(active.a, 0.0, 1.0);
    return half4(clamp(active.rgb + destination.rgb * factor, 0.0, 1.0),
                 clamp(active.a + destination.a * factor, 0.0, 1.0));
}
