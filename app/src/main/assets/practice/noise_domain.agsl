// Phigros 4.0.1 APK GLES3 ActiveBlock / DisabledBlock fragment formula translation.
// Geometry masks use Android field pixels; chart and Unity UVs have a bottom-left origin.
uniform float4 _Time;
uniform float4 _ScreenParams;
uniform float4 _EffectRT_TexelSize;
uniform int _TouchPosCount;
uniform float2 _TouchPos[10];
uniform float _TouchPosShine;
uniform shader _ComposeRT;
