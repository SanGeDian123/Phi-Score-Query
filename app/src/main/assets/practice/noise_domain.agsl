uniform shader _DisabledComposeRT;
uniform shader _DisplaceMap;
uniform shader _TouchDisplaceMap;
uniform shader _SparkMap;
uniform shader _NoiseMap;
uniform shader _SceneColor;
uniform shader _BackgroundColor;
uniform float2 _SceneRenderScale;
uniform int _OverlayOnly;
float2 androidPosition(float2 uv) { return float2(uv.x, 1.0 - uv.y) * _ScreenParams.xy; }
float4 sample_ComposeRT(float2 uv) { return float4(_ComposeRT.eval(androidPosition(uv))); }
float4 sample_EffectRT(float2 uv) { return float4(_EffectRT.eval(androidPosition(uv))); }
float4 sample_DisabledNormalBlockRT(float2 uv) { return float4(_DisabledNormalBlockRT.eval(androidPosition(uv))); }
float4 sample_DisabledSubtractBlockRT(float2 uv) { return float4(_DisabledSubtractBlockRT.eval(androidPosition(uv))); }
float4 sample_ReadyComposeRT(float2 uv) { return float4(_ReadyComposeRT.eval(androidPosition(uv))); }
float4 sample_TouchHoverRT(float2 uv) { return float4(_TouchHoverRT.eval(androidPosition(uv))); }
float4 sample_DisabledComposeRT(float2 uv) { return float4(_DisabledComposeRT.eval(androidPosition(uv))); }
float4 sample_DisplaceMap(float2 uv) { return float4(_DisplaceMap.eval(float2(uv.x, 1.0 - uv.y) * float2(256.0, 256.0))); }
float4 sample_TouchDisplaceMap(float2 uv) { return float4(_TouchDisplaceMap.eval(float2(uv.x, 1.0 - uv.y) * float2(256.0, 256.0))); }
float4 sample_SparkMap(float2 uv) { return float4(_SparkMap.eval(float2(uv.x, 1.0 - uv.y) * float2(128.0, 128.0))); }
float4 sample_NoiseMap(float2 uv) { return float4(_NoiseMap.eval(float2(uv.x, 1.0 - uv.y) * float2(256.0, 256.0))); }
