const float D_DisplaceSpeed = 0.30000001192092896;
const float4 D_DisplaceDirection = float4(1.0, 1.0, 0.0, 0.0);





const float4 D_DisplaceMap_ST = float4(0.5, 0.20000000298023224, 0.0, 0.0);
const float4 D_SparkMap_ST = float4(3.0, 1.2000000476837158, 0.0, 0.0);
float4 disabledFragment(float2 uv) {
float2 Dvs_TEXCOORD0 = uv;
float2 Dvs_TEXCOORD2 = uv * D_DisplaceMap_ST.xy + D_DisplaceMap_ST.zw;
float2 Dvs_TEXCOORD3 = uv * D_SparkMap_ST.xy + D_SparkMap_ST.zw;
float4 Dvs_COLOR0 = float4(1.0);

float Du_xlat16_0 = float(0);
float3 Du_xlat16_1 = float3(0);
float4 Du_xlat2 = float4(0);
float Du_xlat16_3 = float(0);
float3 Du_xlat4 = float3(0);
float Du_xlat16_4 = float(0);
bool Du_xlatb4 = bool(false);
float Du_xlat16_8 = float(0);
float Du_xlat16_9 = float(0);
float Du_xlat16_13 = float(0);

float4 DSV_Target0 = float4(0.0);

    Du_xlat16_0 = sample_DisabledComposeRT(Dvs_TEXCOORD0.xy).x;
    Du_xlat16_1.x = Du_xlat16_0 + -9.99999975e-05;
    Du_xlatb4 = Du_xlat16_1.x<0.0;
    if(Du_xlatb4){return float4(0.0);}
    Du_xlat4.x = _Time.x * D_DisplaceSpeed;
    Du_xlat16_1.x = dot(D_DisplaceDirection.xy, D_DisplaceDirection.xy);
    Du_xlat16_1.x = inversesqrt(Du_xlat16_1.x);
    Du_xlat16_1.xy = Du_xlat16_1.xx * D_DisplaceDirection.xy;
    Du_xlat2.xyw = Du_xlat4.xxx * Du_xlat16_1.xyx;
    Du_xlat2.z = Du_xlat4.x * (-Du_xlat16_1.y);
    Du_xlat2 = Du_xlat2 + Dvs_TEXCOORD2.xyxy;
    Du_xlat16_4 = sample_DisplaceMap(Du_xlat2.zw).x;
    Du_xlat16_8 = sample_DisplaceMap(Du_xlat2.xy).x;
    Du_xlat16_9 = Du_xlat16_4 + -0.5;
    Du_xlat16_13 = Du_xlat16_4 + Du_xlat16_8;
    Du_xlat16_3 = Du_xlat16_8 + -0.5;
    Du_xlat16_13 = Du_xlat16_13 * 0.5;
    Du_xlat2.x = Du_xlat16_9 * (-Du_xlat16_1.y);
    Du_xlat2.y = Du_xlat16_9 * Du_xlat16_1.x;
    Du_xlat4.xy = Du_xlat16_1.xy * float2(Du_xlat16_3) + Du_xlat2.xy;
    Du_xlat4.xy = Du_xlat4.xy * float2(D_SparkDisplaceIntensity) + Dvs_TEXCOORD3.xy;
    Du_xlat16_4 = sample_SparkMap(Du_xlat4.xy).x;
    Du_xlat4.xyz = float3(Du_xlat16_4) * D_SparkTint.xyz;
    Du_xlat4.xyz = float3(Du_xlat16_13) * Du_xlat4.xyz;
    Du_xlat16_1.xyz = D_FillColor.xyz * float3(D_FillOpacity);
    Du_xlat16_1.xyz = Du_xlat4.xyz * float3(D_SparkMapOpacity) + Du_xlat16_1.xyz;
    DSV_Target0.xyz = float3(Du_xlat16_0) * Du_xlat16_1.xyz;
    DSV_Target0.w = Dvs_COLOR0.w;
    return DSV_Target0;

}

float4 sample_SceneColor(float2 uv) {
    // DisabledBlock's One/One camera pass already belongs to the scene copied by BlockRender.
    float2 position = androidPosition(uv);
    // Unity's copied SceneColor RT is point-filtered. The RenderEffect child
    // may interpolate, so address the exact centre of its bounded source texel.
    float4 source = float4(_SceneColor.eval(floor(position * _SceneRenderScale) + float2(0.5)));
    float4 background = float4(_BackgroundColor.eval(position));
    source = source + background * (1.0 - source.a);
    float4 disabled = disabledFragment(uv);
    return float4(clamp(source.rgb + disabled.rgb, 0.0, 1.0), source.a);
}
